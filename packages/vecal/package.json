{
  "name": "vecal",
  "version": "1.0.0-rc.1",
  "description": "A lightweight browser-local vector database backed by IndexedDB",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObservedObserver/vecal.git",
    "directory": "packages/vecal"
  },
  "homepage": "https://github.com/ObservedObserver/vecal#readme",
  "bugs": "https://github.com/ObservedObserver/vecal/issues",
  "keywords": ["vector", "database", "indexeddb", "hnsw", "browser", "local-first"],
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest --config ./jest.config.cjs --watchman=false",
    "test:coverage": "yarn test --coverage --runInBand",
    "test:browser": "playwright test",
    "test:benchmark": "VECAL_RELEASE_BENCHMARK=1 playwright test --config ./playwright.benchmark.config.ts",
    "test:types": "tsc -p ./test/consumer/tsconfig.json --noEmit",
    "test:consumers": "node ./scripts/consumer-smoke.mjs",
    "test:consumers:browser": "node ./scripts/consumer-smoke.mjs --browser",
    "test:smoke": "yarn build && node ./scripts/verify-package.mjs && yarn test:consumers",
    "prepublishOnly": "yarn test --runInBand && yarn test:smoke && yarn test:types"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "1.61.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "fake-indexeddb": "^6.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
